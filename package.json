{
  "name": "r2album",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -n client,worker -c cyan,yellow \"pnpm dev:client\" \"pnpm dev:worker\"",
    "dev:client": "vite",
    "dev:worker": "wrangler dev --port 8787",
    "build": "vite build",
    "preview": "pnpm build && wrangler dev --port 8787",
    "deploy": "pnpm build && wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply r2album-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply r2album-db --remote",
    "type-check": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.worker.json --noEmit",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "lint:fix": "eslint \"src/**/*.{ts,tsx}\" --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e:local": "pnpm build && node scripts/e2e-local.mjs"
  },
  "dependencies": {
    "hono": "^4.7.0",
    "lithent": "^1.25.12"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250408.0",
    "@eslint/js": "^9.16.0",
    "@lithent/lithent-vite": "^0.4.1",
    "@tailwindcss/vite": "^4.1.0",
    "@testing-library/dom": "^10.4.0",
    "@types/node": "^22.12.0",
    "concurrently": "^9.1.2",
    "eslint": "^9.16.0",
    "eslint-config-prettier": "^9.1.0",
    "happy-dom": "^17.4.0",
    "prettier": "^3.4.2",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.17.0",
    "vite": "^8.3.6",
    "vitest": "^4.1.12",
    "wrangler": "^4.10.0"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
